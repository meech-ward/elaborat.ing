# Public values for the browser-test build (`vite build --mode browser-test`).
# Nothing listens here: the browser tests answer Supabase Auth's requests
# themselves.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_browser_tests
# The assistant on a ChatGPT plan (the tests answer /chatgpt/* themselves).
VITE_CHATGPT_PLAN=1
