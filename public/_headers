/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# The service worker and the web manifest are checked again on every load, so
# a new version is found as soon as it is deployed.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# Built files carry a hash of their content in their name, and a new version
# has new names, so a browser keeps them without asking again.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The chat card's editor and component previews (public/chat-card, built by
# `bun run build:chat-card`), which the card imports from inside a chat's
# sandboxed frame: module scripts load with CORS, and the preview frame's
# origin is opaque. Content-hashed like the built files.
/chat-card/*
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
  Cache-Control: public, max-age=31536000, immutable

# The style guide is for the people building the app, not for search.
/style-guide
  X-Robots-Tag: noindex
