{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // A single-page app on Cloudflare Workers static assets: files come from
  // ./dist, and unknown paths fall back to index.html so client-side routes
  // work. The small Worker (worker/index.ts) runs first only for the MCP
  // server's paths, which it passes to the Supabase Edge Function, and for
  // /embed, the app in a chat's panel, whose framing policy it sets.
  "name": "elaborating",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /mcp-probe: temporary host capability probe, remove after testing.
    "run_worker_first": ["/mcp", "/mcp/*", "/.well-known/oauth-protected-resource/mcp", "/.well-known/openai-apps-challenge", "/embed", "/embed/*", "/mcp-probe", "/mcp-probe/*"]
  },
  // The hosted instance's MCP server. Self-hosters: your project's
  // https://<ref>.supabase.co/functions/v1/mcp-server, or remove it.
  // OPENAI_APPS_CHALLENGE (not set here yet): the token OpenAI gives to verify
  // the domain when a plugin is submitted, served as plain text at
  // /.well-known/openai-apps-challenge. It is public, so add it to "vars".
  // EMBED_FRAME_ANCESTORS: who may frame /embed, the app in a chat's panel,
  // separated by spaces: origins, or https://*. and a domain for a host that
  // serves each app from its own subdomain. ChatGPT serves plugin views from
  // subdomains of web-sandbox.oaiusercontent.com inside chatgpt.com. The
  // panel's one-time pass is what keeps an account's data out of any other
  // view's frame (docs/architecture.md, Frontend hosting). Unset, or with a
  // bare wildcard, a path or anything else, nothing may frame it. The panel
  // shows its origins under Details when it cannot open.
  // MCP_PROBE_UPSTREAM: temporary host capability probe, remove after testing.
  "vars": {
    "MCP_UPSTREAM": "https://njxjkmtvconypwujbiur.supabase.co/functions/v1/mcp-server",
    // The database's region: the MCP function runs there, so its several
    // database round trips per tool call stay in one region.
    "MCP_REGION": "us-east-1",
    "EMBED_FRAME_ANCESTORS": "https://*.web-sandbox.oaiusercontent.com https://chatgpt.com",
    "MCP_PROBE_UPSTREAM": "https://njxjkmtvconypwujbiur.supabase.co/functions/v1/mcp-probe"
  },
  // The hosted instance's domain. Self-hosters: change or remove this route.
  "routes": [{ "pattern": "elaborat.ing", "custom_domain": true }]
}
