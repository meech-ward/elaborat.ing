{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // A static single-page app on Cloudflare Workers static assets. There is no
  // Worker script: every request is served from ./dist, and unknown paths fall
  // back to index.html so client-side routes work.
  "name": "elaborating",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // The hosted instance's domain. Self-hosters: change or remove this route.
  "routes": [{ "pattern": "elaborat.ing", "custom_domain": true }]
}
