# Public values only: Vite inlines VITE_ variables into the browser bundle.
# Find both in the Supabase dashboard under Project Settings > API Keys.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: the origin of a separate domain that serves the note frame's page
# (wrangler.sandbox.jsonc). Unset, notes render in a frame inside the page.
# VITE_SANDBOX_ORIGIN=https://your-sandbox-domain.example

# The MCP server's function secrets (supabase/functions/mcp-server), set with
# `supabase secrets set`, not here: EMBED_VIEW_ENABLED=false removes the
# open_panel tool and its view (the app beside the chat); it is on otherwise.
# Who may frame that panel is EMBED_FRAME_ANCESTORS in wrangler.jsonc.
